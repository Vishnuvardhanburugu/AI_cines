# Default: Gemini free-tier API (Google AI Studio)
# https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: xAI Grok API (paid/prepaid — free Grok chat on X is NOT the API)
# https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# Other providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=llama3.2

# Offline demo without any key:
# LLM_PROVIDER=mock

# Free / quality image generation (no video)
# For Gemini-quality stills (recommended for mythic epics):
#   1) Get a key: https://aistudio.google.com/apikey
#   2) Set GEMINI_API_KEY below and restart backend
#   3) In UI choose Provider: Gemini, Aspect: Portrait 9:16
# auto = Gemini image if GEMINI_API_KEY set, else Pollinations (lower quality)
# pollinations | gemini | mock
IMAGE_PROVIDER=auto
POLLINATIONS_BASE_URL=https://image.pollinations.ai
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_TIMEOUT_SECONDS=90
IMAGE_MAX_PROMPT_LENGTH=1500

# Server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_PROMPT_LENGTH=12000
REQUEST_TIMEOUT_SECONDS=60
RATE_LIMIT=30/minute
DEBUG=false

# Frontend (build-time). Leave empty when using Vite/nginx proxy.
VITE_API_URL=
